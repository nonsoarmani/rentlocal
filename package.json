{
  "name": "rentlocalmachinery",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "check": "astro check",
    "db:create": "wrangler d1 create rentlocalmachinery-db",
    "db:migrate:local": "wrangler d1 migrations apply rentlocalmachinery-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rentlocalmachinery-db --remote",
    "deploy": "npm run build && wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.14.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20250901.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
