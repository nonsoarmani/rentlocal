---
// src/components/YardCard.astro
// Partner (is_partner = 1): full phone, direct booking, "Verified Partner" badge.
// Free listing (is_partner = 0): name + city only; contact details are NEVER sent to the browser —
// they are not even rendered into the HTML — so the lead has to route through our form.
import type { RentalYard } from '../lib/db';

interface Props {
  yard: RentalYard;
  miles?: number; // set for yards outside the page's city
}
const { yard, miles } = Astro.props;
const isPartner = yard.is_partner === 1;
const telHref = yard.phone ? `tel:${yard.phone.replace(/[^\d+]/g, '')}` : undefined;
---

<article
  class:list={[
    'rounded-xl bg-white p-5 shadow-sm ring-1',
    isPartner ? 'ring-2 ring-brand-500' : 'ring-slate-200',
  ]}
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-lg font-bold text-slate-900">{yard.name}</h3>
      <p class="text-sm text-slate-600">
        {isPartner && yard.address ? `${yard.address}, ` : ''}{yard.city}, {yard.state}
        {miles !== undefined && <span class="text-slate-500"> · ~{Math.round(miles)} mi away</span>}
      </p>
    </div>
    {isPartner && (
      <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">★ Verified Partner</span>
    )}
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    {isPartner ? (
      <>
        {yard.phone && telHref && (
          <a href={telHref} class="text-base font-semibold text-slate-900 hover:underline">{yard.phone}</a>
        )}
        <a
          href="#quote"
          data-request-yard={yard.id}
          data-yard-name={yard.name}
          class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-bold text-steel-900 hover:bg-brand-400"
        >
          Book Direct
        </a>
      </>
    ) : (
      <a
        href="#quote"
        data-request-yard={yard.id}
        data-yard-name={yard.name}
        class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-100"
      >
        Request Quote Through Us
      </a>
    )}
  </div>
</article>
