---
// src/components/LeadForm.astro — the quote request form (the money component). Posts to /api/lead.
// Works without JS (plain POST -> 303 redirect back) and is enhanced with fetch() below.
//  - Machine page: machine + city are fixed (hidden fields).
//  - City page: visitor picks the machine.
//  - State page: visitor picks the city and the machine.
interface Option { slug: string; name: string }
interface Props {
  equipmentName?: string;
  equipmentSlug?: string;
  equipmentOptions?: Option[];
  citySlug?: string;
  cityOptions?: Option[];
  stateCode: string;
  placeLabel: string; // "Austin" or "Texas" — used in the heading
  pagePath: string;
}
const { equipmentName = '', equipmentSlug = '', equipmentOptions = [], citySlug = '', cityOptions = [], stateCode, placeLabel, pagePath } = Astro.props;
const chooseMachine = equipmentOptions.length > 0;
const chooseCity = cityOptions.length > 0;

const today = new Date().toISOString().slice(0, 10);
const durations = ['1 day', '2–3 days', '1 week', '2 weeks', '1 month', '2+ months'];
const input =
  'mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30';
const label = 'block text-sm font-medium text-slate-700';
---

<section id="quote" class="rounded-2xl bg-white p-6 shadow-xl ring-1 ring-slate-200">
  <h2 class="text-xl font-bold text-slate-900">
    {equipmentName ? `Need a ${equipmentName} in ${placeLabel}?` : `Get equipment rental quotes in ${placeLabel}`}
  </h2>
  <p class="mt-1 text-sm text-slate-600">
    Tell us what you need and we'll get quotes from local rental suppliers. Free, no obligation.
  </p>

  <form id="lead-form" method="post" action="/api/lead" class="mt-5 space-y-4" novalidate>
    {!chooseMachine && <input type="hidden" name="equipment_slug" value={equipmentSlug} />}
    {!chooseCity && <input type="hidden" name="city_slug" value={citySlug} />}
    <input type="hidden" name="state" value={stateCode} />
    <input type="hidden" name="page_path" value={pagePath} />
    <!-- Honeypot: real users never see or fill this; bots do. -->
    <div class="hidden" aria-hidden="true">
      <label>Leave blank <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>

    {chooseCity && (
      <div>
        <label class={label} for="lead-city">City</label>
        <select class={input} id="lead-city" name="city_slug" required>
          <option value="" disabled selected>Select your city…</option>
          {cityOptions.map((c) => <option value={c.slug}>{c.name}</option>)}
        </select>
      </div>
    )}
    {chooseMachine && (
      <div>
        <label class={label} for="lead-equipment">What do you need?</label>
        <select class={input} id="lead-equipment" name="equipment_slug" required>
          <option value="" disabled selected>Select a machine…</option>
          {equipmentOptions.map((e) => <option value={e.slug}>{e.name}</option>)}
        </select>
      </div>
    )}

    <div>
      <label class={label} for="lead-name">Name</label>
      <input class={input} id="lead-name" name="name" type="text" autocomplete="name" required />
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class={label} for="lead-phone">Phone</label>
        <input class={input} id="lead-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
      </div>
      <div>
        <label class={label} for="lead-email">Email</label>
        <input class={input} id="lead-email" name="email" type="email" autocomplete="email" required />
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <div>
        <label class={label} for="lead-zip">Delivery ZIP</label>
        <input class={input} id="lead-zip" name="delivery_zip" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" required />
      </div>
      <div>
        <label class={label} for="lead-start">Project start date</label>
        <input class={input} id="lead-start" name="start_date" type="date" min={today} required />
      </div>
      <div>
        <label class={label} for="lead-duration">Estimated duration</label>
        <select class={input} id="lead-duration" name="duration" required>
          <option value="" disabled selected>Select…</option>
          {durations.map((d) => <option value={d}>{d}</option>)}
        </select>
      </div>
    </div>

    <label class="flex items-start gap-2 text-xs text-slate-600">
      <input type="checkbox" name="consent" id="lead-consent" required class="mt-0.5 h-4 w-4 shrink-0 rounded border-slate-300" />
      <span>
        I agree to be contacted by phone, text or email by RentLocalMachinery and equipment rental suppliers about this
        request. Consent is not a condition of renting. See our <a href="/privacy" class="underline">Privacy Policy</a>
        and <a href="/terms" class="underline">Terms</a>.
      </span>
    </label>

    <p id="lead-error" role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"></p>

    <button
      type="submit"
      id="lead-submit"
      class="w-full rounded-lg bg-brand-500 px-5 py-3 text-base font-bold text-steel-900 shadow transition hover:bg-brand-400 focus:outline-none focus:ring-4 focus:ring-brand-500/40 disabled:opacity-60"
    >
      Get My Free Quotes
    </button>
  </form>

  <div id="lead-success" class="hidden py-8 text-center" role="status">
    <p class="text-2xl font-bold text-slate-900">Request received ✓</p>
    <p class="mt-2 text-slate-600">We'll contact local suppliers and get quotes back to you shortly.</p>
  </div>
</section>

<script>
  // Progressive enhancement: submit via fetch so the visitor keeps their place on the page.
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  if (form) {
    const err = document.getElementById('lead-error')!;
    const btn = document.getElementById('lead-submit') as HTMLButtonElement;
    const ok = document.getElementById('lead-success')!;
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      err.classList.add('hidden');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error((data as { error?: string }).error || 'Something went wrong.');
        form.classList.add('hidden');
        ok.classList.remove('hidden');
      } catch (e) {
        err.textContent = (e as Error).message;
        err.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Get My Free Quotes';
      }
    });
  }
</script>
