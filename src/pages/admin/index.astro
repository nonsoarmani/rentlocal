---
// src/pages/admin/index.astro — password-protected CSV uploader for rental yards.
// One page, three jobs: log in, log out, upload. Everything happens in the browser.
import Layout from '../../layouts/Layout.astro';
import { COOKIE_NAME, SESSION_HOURS, makeSessionValue, passwordMatches, sessionIsValid } from '../../lib/admin-auth';
import { getAllEquipment } from '../../lib/db';
import { importYards, parseYardCsv, MAX_ROWS, type ImportSummary } from '../../lib/yard-import';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const env = Astro.locals.runtime.env;
const password = env.ADMIN_PASSWORD ?? '';
const db = env.DB;
const setupMissing = password.length < 8; // refuse to run with no / tiny password

let loggedIn = await sessionIsValid(Astro.cookies.get(COOKIE_NAME)?.value, password);
let loginError = '';
let uploadError = '';
let summary: ImportSummary | null = null;
let fileName = '';

if (!setupMissing && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'login') {
    const ok = await passwordMatches(String(form.get('password') ?? ''), password);
    if (ok) {
      Astro.cookies.set(COOKIE_NAME, await makeSessionValue(password), {
        httpOnly: true,
        secure: Astro.url.protocol === 'https:',
        sameSite: 'strict',
        path: '/admin',
        maxAge: SESSION_HOURS * 3600,
      });
      loggedIn = true;
    } else {
      await new Promise((r) => setTimeout(r, 1200)); // slows down password guessing
      loginError = 'Wrong password.';
    }
  } else if (action === 'logout') {
    Astro.cookies.delete(COOKIE_NAME, { path: '/admin' });
    loggedIn = false;
  } else if (action === 'upload' && loggedIn) {
    const file = form.get('csv');
    if (!(file instanceof File) || file.size === 0) {
      uploadError = 'Please choose a CSV file first.';
    } else if (file.size > 2_000_000) {
      uploadError = 'That file is too large (limit 2 MB). Split it into smaller files.';
    } else {
      fileName = file.name;
      const parsed = parseYardCsv(await file.text());
      if (parsed.fatal) {
        uploadError = parsed.fatal;
      } else {
        const types = await getAllEquipment(db);
        const defaults = form.getAll('default_equipment').map(String);
        summary = await importYards(db, parsed, types, defaults);
      }
    }
  }
}

const equipment = loggedIn ? await getAllEquipment(db) : [];
const counts = loggedIn
  ? await db
      .prepare('SELECT COUNT(*) AS yards, COALESCE(SUM(is_partner), 0) AS partners, COUNT(DISTINCT state) AS states FROM rental_yards')
      .first<{ yards: number; partners: number; states: number }>()
  : null;

const input = 'mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30';
---

<Layout title="Admin | RentLocalMachinery" description="Admin" noindex canonicalPath="/admin">
  <div class="mx-auto max-w-3xl px-4 py-10">
    {setupMissing && (
      <div class="rounded-xl bg-red-50 p-6 text-red-800 ring-1 ring-red-200">
        <h1 class="text-xl font-bold">Admin password not set up yet</h1>
        <p class="mt-2">
          In Cloudflare, open your project → <strong>Settings</strong> → <strong>Variables and Secrets</strong> →
          <strong>Add</strong>. Name: <code>ADMIN_PASSWORD</code>, type <strong>Secret</strong>, value: a long password
          (at least 8 characters, 12+ is better). Save, then redeploy the site.
        </p>
      </div>
    )}

    {!setupMissing && !loggedIn && (
      <form method="post" class="mx-auto max-w-sm rounded-2xl bg-white p-6 shadow ring-1 ring-slate-200">
        <h1 class="text-xl font-bold text-slate-900">Admin login</h1>
        <input type="hidden" name="action" value="login" />
        <label class="mt-4 block text-sm font-medium text-slate-700" for="pw">Password</label>
        <input class={input} id="pw" name="password" type="password" autocomplete="current-password" required autofocus />
        {loginError && <p role="alert" class="mt-3 text-sm text-red-700">{loginError}</p>}
        <button class="mt-5 w-full rounded-lg bg-steel-900 px-4 py-2.5 font-semibold text-white hover:bg-steel-800">Log in</button>
      </form>
    )}

    {!setupMissing && loggedIn && (
      <>
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-extrabold text-slate-900">Upload rental yards</h1>
          <form method="post"><input type="hidden" name="action" value="logout" />
            <button class="text-sm text-slate-600 underline hover:text-slate-900">Log out</button></form>
        </div>

        {counts && (
          <p class="mt-2 text-sm text-slate-600">
            Right now the site has <strong>{counts.yards}</strong> yards in <strong>{counts.states}</strong> {counts.states === 1 ? 'state' : 'states'}
            ({counts.partners} partners).
          </p>
        )}

        {summary && (
          <section class="mt-6 rounded-xl bg-green-50 p-5 ring-1 ring-green-200" role="status">
            {summary.failed ? (
              <p class="font-semibold text-red-800">{summary.failed}</p>
            ) : (
              <>
                <p class="text-lg font-bold text-green-900">Upload finished ✓ <span class="font-normal text-green-800">({fileName})</span></p>
                <ul class="mt-2 text-green-900">
                  <li><strong>{summary.added}</strong> new yards added</li>
                  <li><strong>{summary.updated}</strong> existing yards updated</li>
                  <li><strong>{summary.linked}</strong> yards linked to machines</li>
                </ul>
              </>
            )}
            {summary.problems.length > 0 && (
              <details class="mt-3" open>
                <summary class="cursor-pointer font-semibold text-amber-800">{summary.problems.length} things to check</summary>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-amber-900">
                  {summary.problems.slice(0, 50).map((p) => <li>{p}</li>)}
                  {summary.problems.length > 50 && <li>…and {summary.problems.length - 50} more.</li>}
                </ul>
              </details>
            )}
          </section>
        )}
        {uploadError && <p role="alert" class="mt-6 rounded-xl bg-red-50 p-4 text-red-800 ring-1 ring-red-200">{uploadError}</p>}

        <form method="post" enctype="multipart/form-data" class="mt-6 space-y-6 rounded-2xl bg-white p-6 shadow ring-1 ring-slate-200">
          <input type="hidden" name="action" value="upload" />

          <div>
            <label class="block font-semibold text-slate-900" for="csv">1. Choose your CSV file</label>
            <input class={input} id="csv" name="csv" type="file" accept=".csv,text/csv" required />
            <p class="mt-1 text-sm text-slate-600">
              Not sure how it should look? <a class="font-medium text-brand-700 underline" href="/yard-template.csv" download>Download the template</a>
              and fill it in with Excel or Google Sheets (File → Download → CSV). Up to {MAX_ROWS} yards per upload.
            </p>
          </div>

          <fieldset>
            <legend class="font-semibold text-slate-900">2. Machines to link when a row doesn't list any</legend>
            <p class="text-sm text-slate-600">
              Yards are linked to whatever is in the <code>equipment</code> column of your file. For rows where that
              cell is empty, tick the machines you want linked automatically (leave all unticked to link nothing).
            </p>
            <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
              {equipment.map((e) => (
                <label class="flex items-center gap-2 text-slate-800">
                  <input type="checkbox" name="default_equipment" value={e.slug} class="h-4 w-4 rounded border-slate-300" /> {e.name}
                </label>
              ))}
            </div>
          </fieldset>

          <button class="rounded-lg bg-brand-500 px-6 py-3 font-bold text-steel-900 shadow hover:bg-brand-400">Upload and save</button>
        </form>

        <div class="mt-8 rounded-xl bg-white p-5 text-sm text-slate-700 ring-1 ring-slate-200">
          <h2 class="font-semibold text-slate-900">How your file should look</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <li><strong>Required columns:</strong> <code>name</code>, <code>city</code>, <code>state</code> (e.g. TX or Texas).</li>
            <li><strong>Optional:</strong> <code>address</code>, <code>zip</code>, <code>phone</code>, <code>email</code>, <code>website</code>, <code>latitude</code>, <code>longitude</code>.</li>
            <li><code>equipment</code>: machines the yard stocks, separated by semicolons, e.g. <em>Skid Steer; Boom Lift</em>. Available: {equipment.map((e) => e.name).join(', ') || '—'}.</li>
            <li><code>partner</code>: write <em>yes</em> for paying partners (they show the phone number and "Book Direct").</li>
            <li>Uploading the same yard again updates it instead of duplicating it. Empty cells never erase existing data.</li>
            <li>Uploads only <em>add</em> machine links. They never remove them.</li>
          </ul>
        </div>
      </>
    )}
  </div>
</Layout>
