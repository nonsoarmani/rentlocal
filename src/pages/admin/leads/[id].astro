---
// /admin/leads/:id — one lead: contact, matching yards, forward it, record the outcome and money.
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/AdminNav.astro';
import { isAdmin } from '../../../lib/admin-guard';
import {
  STATUSES, STATUS_LABEL, countNewLeads, ensureLeadSchema, leadSummary, matchingYards, updateLead, type Lead,
} from '../../../lib/leads';
import { titleCaseSlug } from '../../../lib/us-states';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const env = Astro.locals.runtime.env;
if (!(await isAdmin(Astro.cookies, env))) return Astro.redirect('/admin');
const db = env.DB;
await ensureLeadSchema(db);

const id = Number(Astro.params.id);
if (!Number.isInteger(id)) return new Response(null, { status: 404 });

let formError = '';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const err = await updateLead(db, {
    id,
    status: String(f.get('status') ?? ''),
    notes: String(f.get('notes') ?? ''),
    saleAmount: String(f.get('sale_amount') ?? ''),
    routedTo: String(f.get('routed_to') ?? ''),
  });
  if (!err) return Astro.redirect(`/admin/leads/${id}?saved=1`, 303);
  formError = err;
}

const lead = await db
  .prepare(
    `SELECT l.*, e.name AS equipment_name, ry.name AS requested_yard_name, rt.name AS routed_yard_name
       FROM leads l
       LEFT JOIN equipment_types e ON e.slug = l.equipment_slug
       LEFT JOIN rental_yards ry   ON ry.id = l.yard_id
       LEFT JOIN rental_yards rt   ON rt.id = l.routed_to_yard_id
      WHERE l.id = ?`,
  )
  .bind(id)
  .first<Lead>();
if (!lead) return new Response(null, { status: 404 });

const [matches, newCount] = await Promise.all([matchingYards(db, lead), countNewLeads(db)]);
const cityName = titleCaseSlug(lead.city_slug);
const summary = leadSummary(lead, cityName);
const saved = Astro.url.searchParams.get('saved') === '1';
const input = 'mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30';

const mailto = (yardEmail: string) =>
  `mailto:${yardEmail}?subject=${encodeURIComponent(`New rental request: ${lead.equipment_name ?? ''} in ${cityName}, ${lead.state}`)}&body=${encodeURIComponent(summary + '\n\nPlease contact the customer directly.')}`;
---

<Layout title={`Lead #${lead.id} | Admin`} description="Admin" noindex canonicalPath={`/admin/leads/${lead.id}`}>
  <div class="mx-auto max-w-4xl px-4 py-10">
    <AdminNav current="leads" newLeads={newCount} />
    <a href="/admin/leads" class="text-sm text-slate-600 underline">← All leads</a>
    <h1 class="mt-2 text-2xl font-extrabold text-slate-900">{lead.equipment_name ?? lead.equipment_slug} in {cityName}, {lead.state}</h1>
    <p class="text-sm text-slate-500">Lead #{lead.id} · received {lead.created_at} UTC</p>

    {saved && <p role="status" class="mt-4 rounded-lg bg-green-50 px-4 py-2 text-green-800 ring-1 ring-green-200">Saved ✓</p>}
    {formError && <p role="alert" class="mt-4 rounded-lg bg-red-50 px-4 py-2 text-red-800 ring-1 ring-red-200">{formError}</p>}

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <section class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
        <h2 class="font-bold text-slate-900">Customer</h2>
        <dl class="mt-3 space-y-1 text-sm text-slate-700">
          <div><dt class="inline font-semibold">Name:</dt> <dd class="inline">{lead.name}</dd></div>
          <div><dt class="inline font-semibold">Phone:</dt> <dd class="inline"><a class="text-brand-700 underline" href={`tel:${lead.phone.replace(/[^\d+]/g, '')}`}>{lead.phone}</a></dd></div>
          <div><dt class="inline font-semibold">Email:</dt> <dd class="inline"><a class="text-brand-700 underline" href={`mailto:${lead.email}`}>{lead.email}</a></dd></div>
          <div><dt class="inline font-semibold">Delivery ZIP:</dt> <dd class="inline">{lead.delivery_zip}</dd></div>
          <div><dt class="inline font-semibold">Start date:</dt> <dd class="inline">{lead.start_date}</dd></div>
          <div><dt class="inline font-semibold">Duration:</dt> <dd class="inline">{lead.duration}</dd></div>
          {lead.requested_yard_name && <div><dt class="inline font-semibold">Asked for yard:</dt> <dd class="inline">{lead.requested_yard_name}</dd></div>}
          {lead.page_url && <div><dt class="inline font-semibold">From page:</dt> <dd class="inline"><a class="underline" href={lead.page_url}>{lead.page_url}</a></dd></div>}
        </dl>
        <label class="mt-4 block text-xs font-semibold uppercase tracking-wide text-slate-500" for="summary">Copy &amp; paste (WhatsApp, SMS, email)</label>
        <textarea id="summary" readonly rows="7" class="mt-1 w-full rounded-lg border border-slate-300 bg-slate-50 p-2 text-xs">{summary}</textarea>
      </section>

      <section class="rounded-xl bg-white p-5 ring-1 ring-slate-200">
        <h2 class="font-bold text-slate-900">Yards that stock this machine</h2>
        <p class="mt-1 text-xs text-slate-500">Partners first. Full contact details are visible here only to you.</p>
        {matches.length === 0 ? (
          <p class="mt-3 text-sm text-slate-600">No matching yards in the database for this city and machine.</p>
        ) : (
          <ul class="mt-3 space-y-3 text-sm">
            {matches.map(({ yard, miles }) => (
              <li class="rounded-lg bg-slate-50 p-3">
                <p class="font-semibold text-slate-900">
                  {yard.name} {yard.is_partner === 1 && <span class="ml-1 rounded-full bg-brand-100 px-2 py-0.5 text-xs text-brand-700">Partner</span>}
                </p>
                <p class="text-slate-600">{yard.city}, {yard.state}{miles !== null && ` · ~${Math.round(miles)} mi away`}</p>
                <p class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
                  {yard.phone && <a class="text-brand-700 underline" href={`tel:${yard.phone.replace(/[^\d+]/g, '')}`}>{yard.phone}</a>}
                  {yard.email && <a class="text-brand-700 underline" href={mailto(yard.email)}>Email this lead to them</a>}
                  {!yard.phone && !yard.email && <span class="text-slate-500">No contact details on file</span>}
                </p>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>

    <form method="post" class="mt-6 space-y-4 rounded-xl bg-white p-5 ring-1 ring-slate-200">
      <h2 class="font-bold text-slate-900">Track this lead</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <label class="text-sm font-medium text-slate-700" for="status">Status</label>
          <select id="status" name="status" class={input}>
            {STATUSES.map((s) => <option value={s} selected={lead.status === s}>{STATUS_LABEL[s]}</option>)}
          </select>
        </div>
        <div>
          <label class="text-sm font-medium text-slate-700" for="routed_to">Sent to yard</label>
          <select id="routed_to" name="routed_to" class={input}>
            <option value="">— nobody yet —</option>
            {lead.routed_to_yard_id && !matches.some((m) => m.yard.id === lead.routed_to_yard_id) && (
              <option value={lead.routed_to_yard_id} selected>{lead.routed_yard_name}</option>
            )}
            {matches.map(({ yard }) => <option value={yard.id} selected={lead.routed_to_yard_id === yard.id}>{yard.name}</option>)}
          </select>
        </div>
        <div>
          <label class="text-sm font-medium text-slate-700" for="sale_amount">Amount earned (USD)</label>
          <input id="sale_amount" name="sale_amount" inputmode="decimal" class={input} value={lead.sale_amount_usd ?? ''} placeholder="e.g. 25" />
        </div>
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700" for="notes">Notes (only you see these)</label>
        <textarea id="notes" name="notes" rows="3" maxlength="2000" class={input}>{lead.notes ?? ''}</textarea>
      </div>
      <button class="rounded-lg bg-brand-500 px-6 py-2.5 font-bold text-steel-900 hover:bg-brand-400">Save</button>
    </form>
  </div>
</Layout>
