---
// /rentals/:state/:city/:equipment  e.g. /rentals/texas/austin/skid-steer-rental
// Lead-generation page: price range + helpful details + quote form. No supplier listings.
import Layout from '../../../../layouts/Layout.astro';
import LeadForm from '../../../../components/LeadForm.astro';
import { getAllEquipment, getCitiesInState, getCityName, getEquipmentBySlug } from '../../../../lib/db';
import { stateFromSlug } from '../../../../lib/us-states';
import { buildFactors, buildFaqs, buildIntro, money, rateRange, rateTable } from '../../../../lib/content';

const { state: stateParam, city: cityParam, equipment: equipmentParam } = Astro.params;
const notFound = () => new Response(null, { status: 404, statusText: 'Not Found' });

const state = stateParam ? stateFromSlug(stateParam) : undefined;
if (!state || !cityParam || !equipmentParam) return notFound();

const db = Astro.locals.runtime.env.DB;
const [equipment, cityName, allEquipment, stateCities] = await Promise.all([
  getEquipmentBySlug(db, equipmentParam),
  getCityName(db, state.code, cityParam),
  getAllEquipment(db),
  getCitiesInState(db, state.code),
]);
if (!equipment || !cityName) return notFound(); // unknown machine or city => real 404

const facts = { equipment, city: cityName, stateName: state.name, stateCode: state.code };
const intro = buildIntro(facts);
const faqs = buildFaqs(facts);
const factors = buildFactors(equipment);
const range = rateRange(equipment.avg_daily_rate_usd);
const table = rateTable(equipment.avg_daily_rate_usd);
const otherEquipment = allEquipment.filter((e) => e.id !== equipment.id);
const otherCities = stateCities.filter((c) => c.slug !== cityParam).slice(0, 12);

const pagePath = `/rentals/${stateParam}/${cityParam}/${equipmentParam}`;
const h1 = `${equipment.name} Rentals in ${cityName}, ${state.code}`;
const title = `${equipment.name} Rental in ${cityName}, ${state.code}: ${range ? `${money(range.min)}–${money(range.max)}/Day, ` : ''}Free Quotes`;
const description = `Renting a ${equipment.name.toLowerCase()} in ${cityName}, ${state.name}?${range ? ` Typical rates are ${money(range.min)}–${money(range.max)} per day.` : ''} Compare local prices and get free quotes from nearby rental suppliers.`;
const site = Astro.site ?? new URL('https://rentlocalmachinery.com');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).toString() },
      { '@type': 'ListItem', position: 2, name: state.name, item: new URL(`/rentals/${stateParam}`, site).toString() },
      { '@type': 'ListItem', position: 3, name: cityName, item: new URL(`/rentals/${stateParam}/${cityParam}`, site).toString() },
      { '@type': 'ListItem', position: 4, name: h1, item: new URL(pagePath, site).toString() },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=86400, stale-while-revalidate=604800');
---

<Layout title={title} description={description} canonicalPath={pagePath} jsonLd={jsonLd}>
  <!-- Hero: headline + price on the left, the quote form above the fold on the right -->
  <section class="bg-gradient-to-b from-steel-900 to-steel-800 pb-12 pt-8 text-white">
    <div class="mx-auto max-w-6xl px-4">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-400">
        <a href="/" class="hover:text-white">Home</a> ›
        <a href={`/rentals/${stateParam}`} class="hover:text-white">{state.name}</a> ›
        <a href={`/rentals/${stateParam}/${cityParam}`} class="hover:text-white">{cityName}</a> ›
        <span class="text-slate-200">{equipment.name}</span>
      </nav>

      <div class="grid items-start gap-8 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-400">{equipment.category}</p>
          <h1 class="mt-2 text-3xl font-extrabold leading-tight sm:text-4xl">{h1}</h1>

          {range && (
            <p class="mt-4 inline-block rounded-lg bg-white/10 px-4 py-3 text-lg">
              Typical price in {cityName}:
              <strong class="text-brand-400"> {money(range.min)}</strong> to
              <strong class="text-brand-400"> {money(range.max)}</strong> per day
              <span class="block text-xs text-slate-400">Estimate based on typical U.S. rates. Your quote depends on size, attachments, length and delivery.</span>
            </p>
          )}

          <ul class="mt-6 space-y-2 text-slate-200">
            <li>✓ One short form, quotes from local suppliers</li>
            <li>✓ Free and no obligation</li>
            <li>✓ Delivery quotes included when you add your ZIP code</li>
          </ul>
        </div>

        <div class="text-left text-slate-800 lg:col-span-2">
          <LeadForm
            equipmentName={equipment.name}
            equipmentSlug={equipment.slug}
            citySlug={cityParam}
            stateCode={state.code}
            placeLabel={cityName}
            pagePath={pagePath}
          />
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl space-y-14 px-4 pt-12">
    <section class="max-w-3xl space-y-3 text-slate-700">
      <h2 class="text-2xl font-bold text-slate-900">Renting a {equipment.name} in {cityName}</h2>
      {intro.map((p) => <p>{p}</p>)}
    </section>

    {table && (
      <section aria-labelledby="rates">
        <h2 id="rates" class="text-2xl font-bold text-slate-900">Typical {equipment.name} rental rates</h2>
        <p class="mt-1 text-sm text-slate-600">A rough guide. Longer rentals cost less per day.</p>
        <div class="mt-4 overflow-hidden rounded-xl bg-white ring-1 ring-slate-200">
          <table class="w-full text-left text-sm">
            <thead class="bg-slate-100 text-slate-600">
              <tr><th class="px-4 py-3">Rental period</th><th class="px-4 py-3">Typical price</th></tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <tr><td class="px-4 py-3">Per day</td><td class="px-4 py-3 font-semibold">{money(table.day.min)} – {money(table.day.max)}</td></tr>
              <tr><td class="px-4 py-3">Per week</td><td class="px-4 py-3 font-semibold">{money(table.week.min)} – {money(table.week.max)}</td></tr>
              <tr><td class="px-4 py-3">Per 4 weeks</td><td class="px-4 py-3 font-semibold">{money(table.month.min)} – {money(table.month.max)}</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section aria-labelledby="factors" class="grid gap-8 md:grid-cols-2">
      <div>
        <h2 id="factors" class="text-2xl font-bold text-slate-900">What affects the price</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-700">
          {factors.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-slate-900">How it works</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-slate-700">
          <li>Fill in the short quote form above. It takes about a minute.</li>
          <li>We contact local equipment suppliers on your behalf.</li>
          <li>You receive availability and pricing, then choose the best offer.</li>
        </ol>
      </div>
    </section>

    <section aria-labelledby="faq">
      <h2 id="faq" class="text-2xl font-bold text-slate-900">{equipment.name} rental FAQs for {cityName}</h2>
      <div class="mt-4 divide-y divide-slate-200 rounded-xl bg-white ring-1 ring-slate-200">
        {faqs.map((f, i) => (
          <details class="group p-5" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-slate-900">
              {f.q}
              <span class="ml-4 text-brand-600 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-slate-700">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section aria-labelledby="more">
      <h2 id="more" class="text-2xl font-bold text-slate-900">More equipment rentals in {cityName}</h2>
      <ul class="mt-4 flex flex-wrap gap-3">
        {otherEquipment.map((e) => (
          <li><a href={`/rentals/${stateParam}/${cityParam}/${e.slug}`} class="inline-block rounded-full bg-white px-4 py-2 text-sm font-medium text-slate-800 ring-1 ring-slate-300 hover:bg-brand-50">{e.name} Rental in {cityName}</a></li>
        ))}
        <li><a href={`/rentals/${stateParam}/${cityParam}`} class="inline-block rounded-full bg-steel-900 px-4 py-2 text-sm font-medium text-white hover:bg-steel-800">All {cityName} equipment →</a></li>
      </ul>
      {otherCities.length > 0 && (
        <>
          <h3 class="mt-8 text-lg font-bold text-slate-900">{equipment.name} rental in other {state.name} cities</h3>
          <ul class="mt-3 flex flex-wrap gap-3">
            {otherCities.map((c) => (
              <li><a href={`/rentals/${stateParam}/${c.slug}/${equipment.slug}`} class="inline-block rounded-full bg-white px-4 py-2 text-sm text-slate-800 ring-1 ring-slate-300 hover:bg-brand-50">{c.city}</a></li>
            ))}
          </ul>
        </>
      )}
    </section>
  </div>
</Layout>
